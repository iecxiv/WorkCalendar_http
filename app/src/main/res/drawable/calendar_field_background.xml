<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#08808080" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#20808080" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#10808080" />
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="?attr/colorAccent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#10808080" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#60808080" />
        </shape>
    </item>
</selector>
