<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MeshFabric-inspired palette, adapted to the existing AppCompat views. -->
    <color name="calendar_dialog_surface">#F7F9FC</color>
    <color name="calendar_dialog_text">#1A1C1E</color>
    <color name="calendar_dialog_secondary">#43474E</color>
    <color name="calendar_dialog_disabled">#611A1C1E</color>
    <color name="calendar_dialog_outline">#C3C7CF</color>
    <color name="calendar_dialog_primary">#0061A4</color>
    <color name="calendar_dialog_ripple">#1F0061A4</color>
    <!-- Use a complete dialog theme rather than inheriting activity window attributes. -->
    <style name="ThemeOverlay.Calendar.SettingsDialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@drawable/calendar_settings_dialog_background</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.45</item>
        <item name="android:colorBackground">@color/calendar_dialog_surface</item>
        <item name="android:colorBackgroundFloating">@color/calendar_dialog_surface</item>
        <item name="android:textColorPrimary">@color/calendar_dialog_text_states</item>
        <item name="android:textColorSecondary">@color/calendar_dialog_secondary</item>
        <item name="android:textColorHint">@color/calendar_dialog_secondary</item>
        <item name="android:textColorLink">@color/calendar_dialog_primary</item>
        <item name="colorAccent">@color/calendar_dialog_primary</item>
        <item name="android:colorAccent">@color/calendar_dialog_primary</item>
        <item name="colorControlNormal">@color/calendar_dialog_outline</item>
        <item name="android:colorControlNormal">@color/calendar_dialog_outline</item>
        <item name="colorControlActivated">@color/calendar_dialog_primary</item>
        <item name="android:colorControlActivated">@color/calendar_dialog_primary</item>
        <item name="colorControlHighlight">@color/calendar_dialog_ripple</item>
        <item name="android:colorControlHighlight">@color/calendar_dialog_ripple</item>
        <item name="buttonStyle">@style/Widget.Calendar.SettingsButton</item>
        <item name="android:buttonStyle">@style/Widget.Calendar.SettingsButton</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Calendar.SettingsAction</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Calendar.SettingsAction</item>
    </style>
    <style name="Widget.Calendar.SettingsButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">@color/calendar_dialog_action_states</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="Widget.Calendar.SettingsAction" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/calendar_dialog_action_states</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>
