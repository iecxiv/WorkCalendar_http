<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shared dialog palette; dark alternatives live in values-night. -->
    <color name="calendar_dialog_surface">#F7F9FC</color>
    <color name="calendar_dialog_text">#1A1C1E</color>
    <color name="calendar_dialog_secondary">#43474E</color>
    <color name="calendar_dialog_disabled">#611A1C1E</color>
    <color name="calendar_dialog_outline">#C3C7CF</color>
    <color name="calendar_dialog_primary">#0061A4</color>
    <color name="calendar_dialog_ripple">#1F0061A4</color>
    <color name="calendar_dialog_field">#FFFFFF</color>
    <color name="calendar_dialog_button">#E3EEFF</color>

    <style name="ThemeOverlay.Calendar.SettingsDialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@drawable/calendar_settings_dialog_background</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.45</item>
        <item name="android:colorBackground">@color/calendar_dialog_surface</item>
        <item name="android:colorBackgroundFloating">@color/calendar_dialog_surface</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textColorPrimary">@color/calendar_dialog_text_states</item>
        <item name="android:textColorSecondary">@color/calendar_dialog_secondary</item>
        <item name="android:textColorHint">@color/calendar_dialog_secondary</item>
        <item name="android:textColorLink">@color/calendar_dialog_primary</item>
        <item name="android:textAppearanceLarge">@style/TextAppearance.Calendar.DialogTitle</item>
        <item name="android:textAppearanceMedium">@style/TextAppearance.Calendar.DialogBody</item>
        <item name="colorAccent">@color/calendar_dialog_primary</item>
        <item name="android:colorAccent">@color/calendar_dialog_primary</item>
        <item name="colorControlNormal">@color/calendar_dialog_outline</item>
        <item name="android:colorControlNormal">@color/calendar_dialog_outline</item>
        <item name="colorControlActivated">@color/calendar_dialog_primary</item>
        <item name="android:colorControlActivated">@color/calendar_dialog_primary</item>
        <item name="colorControlHighlight">@color/calendar_dialog_ripple</item>
        <item name="android:colorControlHighlight">@color/calendar_dialog_ripple</item>
        <item name="android:textViewStyle">@style/Widget.Calendar.SettingsLabel</item>
        <item name="editTextStyle">@style/Widget.Calendar.SettingsField</item>
        <item name="android:editTextStyle">@style/Widget.Calendar.SettingsField</item>
        <item name="checkboxStyle">@style/Widget.Calendar.SettingsCheckBox</item>
        <item name="android:checkboxStyle">@style/Widget.Calendar.SettingsCheckBox</item>
        <item name="buttonStyle">@style/Widget.Calendar.SettingsButton</item>
        <item name="android:buttonStyle">@style/Widget.Calendar.SettingsButton</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Calendar.SettingsAction</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Calendar.SettingsAction</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Calendar.SettingsAction</item>
    </style>

    <style name="TextAppearance.Calendar.DialogTitle" parent="TextAppearance.AppCompat.Title">
        <item name="android:textColor">@color/calendar_dialog_text_states</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.Calendar.DialogBody" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textColor">@color/calendar_dialog_text_states</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="Widget.Calendar.SettingsLabel" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/calendar_dialog_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>
    <style name="Widget.Calendar.SettingsField" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/calendar_dialog_field_background</item>
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/calendar_dialog_text_states</item>
        <item name="android:textColorHint">@color/calendar_dialog_secondary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>
    <style name="Widget.Calendar.SettingsCheckBox" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="buttonTint">@color/calendar_dialog_check_states</item>
        <item name="android:buttonTint">@color/calendar_dialog_check_states</item>
        <item name="android:textColor">@color/calendar_dialog_text_states</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:drawablePadding">8dp</item>
    </style>
    <style name="Widget.Calendar.SettingsButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/calendar_dialog_button_background</item>
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/calendar_dialog_action_states</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Widget.Calendar.SettingsAction" parent="Widget.Calendar.SettingsButton" />
</resources>
